# Copy to .env (gitignored) and fill in. Read by the `unapply` command.

# Claude API key, from https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Paid API calls are off unless this is 1. Leave it at 0 and allow calls one at a
# time instead: `--allow-api` on a command, or the toggle in the app.
UNAPPLY_ALLOW_API_CALLS=0

# Optional: the database, as a SQLAlchemy URL. By default a SQLite file in the data
# folder (sqlite:///data/unapply.db). Postgres needs `uv sync --extra db`, then e.g.
# UNAPPLY_DATABASE_URL=postgresql+psycopg://unapply@localhost/unapply
UNAPPLY_DATABASE_URL=

# Optional: raises the GitHub API limit from 60 to 5,000 requests an hour.
GITHUB_TOKEN=
